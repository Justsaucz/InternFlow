# Database
# Native development: adjust the local port/database/user to your PostgreSQL setup.
# Containers use their database service hostname instead of localhost.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/internflow?schema=public"

# Auth
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
STORAGE_MODE=local

# AWS S3 Configuration (Optional for local development, required for production)
# AWS_REGION="ap-southeast-1"
# STORAGE_MODE=s3
# ECS uses its task role; do not put static AWS keys in this file.
# S3_BUCKET_NAME="internflow-bucket"
