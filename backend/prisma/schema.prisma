generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COMPANY_HR
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?
  documents      Document[]
}


model StudentProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  
  studentId    String   @default("")
  major        String   @default("")
  faculty      String   @default("")
  university   String?  @default("")
  year         Int      @default(1)
  gpa          Float?
  skills       String[]
  bio          String?
  avatarUrl    String?
  
  applications Application[]
  weeklyLogs   WeeklyLog[]
  evaluations  InternshipEvaluation[]
}

model CompanyProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  
  companyName  String
  industry     String
  website      String?
  description  String?
  logoUrl      String?
  address      String?
  contactEmail String?
  contactPhone String?
  
  jobPosts     JobPost[]
  evaluations  InternshipEvaluation[]
}

model JobPost {
  id               String         @id @default(uuid())
  companyProfileId String
  company          CompanyProfile @relation(fields: [companyProfileId], references: [id])
  
  title            String
  description      String
  requirements     String
  location         String
  isRemote         Boolean        @default(false)
  positions        Int            @default(1)
  allowance        String?
  workingHours     String?
  contactEmail     String?
  contactPhone     String?
  contactLine      String?
  applicationLink  String?
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean        @default(true)
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  applications     Application[]
}

model Application {
  id             String            @id @default(uuid())
  jobPostId      String
  jobPost        JobPost           @relation(fields: [jobPostId], references: [id])
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id])
  
  status         ApplicationStatus @default(PENDING)
  coverLetter    String?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  documents      Document[]
  weeklyLogs     WeeklyLog[]
  evaluation     InternshipEvaluation?

  @@unique([studentId, jobPostId])
}

model Document {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  
  title         String
  fileUrl       String
  type          String       // e.g., "CV", "TRANSCRIPT", "REPORT"
  
  createdAt     DateTime     @default(now())
}

model WeeklyLog {
  id                   String         @id @default(uuid())
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id])
  applicationId        String?
  application          Application?   @relation(fields: [applicationId], references: [id])
  
  weekNumber           Int
  startDate            DateTime
  endDate              DateTime
  workModality         String         @default("ON_SITE") // ON_SITE, REMOTE, HYBRID
  supervisorName       String?
  plannedTasks         String?
  tasksDone            String
  problemsAndSolutions String?
  learnings            String
  hoursWorked          Float          @default(40.0)
  attachmentUrl        String?
  
  // Company Sign-off
  mentorApproved       Boolean        @default(false)
  mentorRating         Int?           // 1-5 stars
  mentorFeedback       String?
  

  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

enum EvaluationStatus {
  PENDING_REVIEW
  COMPANY_EVALUATED
}

model InternshipEvaluation {
  id                 String           @id @default(uuid())
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id])
  companyId          String
  company            CompanyProfile   @relation(fields: [companyId], references: [id])
  applicationId      String?          @unique
  application        Application?     @relation(fields: [applicationId], references: [id])
  
  workQualityScore   Int              @default(5)
  punctualityScore   Int              @default(5)
  teamworkScore      Int              @default(5)
  feedback           String
  
  status             EvaluationStatus @default(COMPANY_EVALUATED)
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}
