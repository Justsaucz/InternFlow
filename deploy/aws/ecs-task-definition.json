{
  "family": "internflow-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {"cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "REPLACE_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_TASK_ROLE_ARN",
  "containerDefinitions": [{
    "name": "backend",
    "image": "REPLACE_ECR_IMAGE_URI_WITH_IMMUTABLE_TAG_OR_DIGEST",
    "essential": true,
    "portMappings": [{"containerPort": 4000, "protocol": "tcp"}],
    "environment": [
      {"name": "NODE_ENV", "value": "production"},
      {"name": "PORT", "value": "4000"},
      {"name": "STORAGE_MODE", "value": "s3"},
      {"name": "AWS_REGION", "value": "ap-southeast-1"},
      {"name": "S3_BUCKET_NAME", "value": "REPLACE_PRIVATE_UPLOAD_BUCKET"},
      {"name": "CORS_ORIGIN", "value": "REPLACE_EXACT_FRONTEND_ORIGIN"}
    ],
    "environmentFiles": [{"value": "arn:aws:s3:::REPLACE_PRIVATE_CONFIG_BUCKET/internflow/api.env", "type": "s3"}],
    "healthCheck": {
      "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:4000/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
      "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 45
    },
    "logConfiguration": {"logDriver": "awslogs", "options": {
      "awslogs-group": "/ecs/internflow", "awslogs-region": "ap-southeast-1", "awslogs-stream-prefix": "api"
    }},
    "linuxParameters": {"initProcessEnabled": true},
    "stopTimeout": 30
  }]
}
