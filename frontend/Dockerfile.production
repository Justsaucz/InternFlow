FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN --mount=type=secret,id=build_ca if [ -f /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; npm ci
COPY frontend/ ./
ARG VITE_API_URL=
ARG VITE_ROUTER_MODE=browser
ARG VITE_S3_BUCKET_NAME=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ROUTER_MODE=$VITE_ROUTER_MODE
ENV VITE_S3_BUCKET_NAME=$VITE_S3_BUCKET_NAME
RUN npm run build

FROM scratch AS export
COPY --from=build /app/dist/ /

FROM nginx:stable-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
